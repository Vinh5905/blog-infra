---
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration

discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ kubernetes_api_dns }}:{{ kubernetes_api_port }}"
    token: "{{ kubernetes_join_token }}"
    caCertHashes:
      - "{{ kubernetes_join_ca_hash }}"

nodeRegistration:
  name: "{{ private_dns_name }}"
  criSocket: "{{ kubernetes_cri_socket }}"
  kubeletExtraArgs:
    - name: cloud-provider
      value: external
    - name: node-ip
      value: "{{ private_ip_address }}"