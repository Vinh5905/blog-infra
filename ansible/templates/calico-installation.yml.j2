apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  variant: Calico

  calicoNetwork:
    linuxDataplane: Iptables
    bgp: Disabled
    mtu: 1450

    nodeAddressAutodetectionV4:
      kubernetes: NodeInternalIP

    ipPools:
      - name: default-ipv4-ippool
        cidr: "{{ kubernetes_pod_subnet }}"
        blockSize: 26
        encapsulation: VXLAN
        natOutgoing: Enabled
        nodeSelector: all()