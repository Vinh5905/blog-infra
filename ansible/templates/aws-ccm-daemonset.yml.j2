---
apiVersion: v1
kind: ConfigMap
metadata:
  name: aws-cloud-controller-manager-config
  namespace: kube-system
data:
  aws.conf: |
    [Global]
    KubernetesClusterID = {{ kubernetes_cluster_name }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: aws-cloud-controller-manager
  namespace: kube-system
spec:
  selector:
    matchLabels:
      app: aws-cloud-controller-manager
  template:
    metadata:
      labels:
        app: aws-cloud-controller-manager
    spec:
      serviceAccountName: aws-cloud-controller-manager
      automountServiceAccountToken: true
      priorityClassName: system-cluster-critical

      nodeSelector:
        node-role.kubernetes.io/control-plane: ""

      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
        - key: node.cloudprovider.kubernetes.io/uninitialized
          operator: Equal
          value: "true"
          effect: NoSchedule

      hostNetwork: true
      dnsPolicy: Default

      containers:
        - name: aws-cloud-controller-manager
          image: "registry.k8s.io/provider-aws/cloud-controller-manager:{{ kubernetes_aws_ccm_version }}"
          args:
            - --cloud-provider=aws
            - --controllers=cloud-node-controller,cloud-node-lifecycle-controller
            - --use-service-account-credentials=false
            - --leader-elect=true
            - --secure-port=0
            - --cloud-config=/etc/kubernetes/cloud-provider/aws.conf
          env:
            - name: AWS_REGION
              value: "{{ kubernetes_aws_ccm_region }}"
            - name: AWS_ROLE_ARN
              value: "{{ kubernetes_aws_ccm_role_arn }}"
            - name: AWS_WEB_IDENTITY_TOKEN_FILE
              value: /var/run/secrets/aws/token
          resources:
            requests:
              cpu: 200m
              memory: 128Mi
          volumeMounts:
            - name: aws-web-identity-token
              mountPath: /var/run/secrets/aws
              readOnly: true
            - name: aws-cloud-config
              mountPath: /etc/kubernetes/cloud-provider
              readOnly: true

      volumes:
        - name: aws-web-identity-token
          projected:
            sources:
              - serviceAccountToken:
                  audience: sts.amazonaws.com
                  expirationSeconds: 3600
                  path: token
        - name: aws-cloud-config
          configMap:
            name: aws-cloud-controller-manager-config